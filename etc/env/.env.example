# GoOne 本地开发中间件环境变量样例
#
# 用途：复制本文件为同目录的 .env（被 .gitignore 忽略），填入本地开发值。
# docker-compose 启动 etc/env/env_docker.yaml 时会自动加载同目录 .env。
#
# 安全说明（V4 P0-01）：
# - 仓库不再保存任何真实凭据；本文件只含无权限占位样例值。
# - .env 文件必须保持 git 忽略，不得提交。
# - 生产环境的口令由部署平台（VM/Ansible/K8s Secret）注入，不经过本仓库。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_DATABASE=game

# ---- Redis ----
REDIS_PASSWORD=change-me-redis

# ---- RabbitMQ ----
# 出于安全，默认不允许 guest 远程访问；RABBITMQ_LOOPBACK_USERS 默认为 guest。
RABBITMQ_DEFAULT_USER=change-me-rabbit-user
RABBITMQ_DEFAULT_PASS=change-me-rabbit-pass
# RABBITMQ_LOOPBACK_USERS=none  # 仅在需要放开 guest 远程访问时设置（不推荐）

# ---- GoOne server_conf.yaml 部署模板变量（Ansible/部署脚本注入） ----
# 这些值在部署期渲染 module/gconf/server_conf.yaml 的 {{ }} 占位符。
MYSQL_MASTER_IP=127.0.0.1
MYSQL_MASTER_PORT=3306
MYSQL_MASTER_USER=root
MYSQL_MASTER_PASSWORD=change-me-mysql
MYSQL_MASTER_DB=poker

REDIS_IP=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWD=change-me-redis
REDIS_USE_CLUSTER=false

HTTP_SIGN_PRIVATE_KEY=change-me-sign-key

REST_API_GETGAMEROLE_URL=http://127.0.0.1:8000/mg/api/sdk/getGameRole?

NACOS_IP=127.0.0.1
NACOS_PORT=8848
NACOS_NAMESPACE_ID=change-me-namespace
NACOS_GROUP_NAME=poker_gameconf
NACOS_USER_NAME=change-me-nacos-user
NACOS_PASSWORD=change-me-nacos

# ---- logger fatal 通知（钉钉机器人 webhook，可选） ----
# 留空则不启用 fatal 外发通知（推荐开发环境）。完整 webhook 地址由部署注入。
DINGDING_FATAL_HOOK=

# ---- 部署拓扑占位 ----
ROOT_PATH=.
ZK_ADDRESS=127.0.0.1:2181
RABBITMQ_ADDRESS=amqp://127.0.0.1:5672
INSTANCE_ID=1
